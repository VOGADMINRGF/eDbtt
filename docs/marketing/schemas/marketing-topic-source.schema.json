{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edebatte.org/schemas/marketing-topic-source.schema.json",
  "title": "Marketing Topic Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "publisher",
    "sourceType",
    "jurisdiction",
    "originalLanguages",
    "transport",
    "endpoint",
    "fetchIntervalMinutes",
    "licensePolicy",
    "storagePolicy",
    "freshness",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceType": {
      "enum": [
        "government",
        "parliament",
        "authority",
        "international_institution",
        "science",
        "public_broadcaster",
        "news_provider",
        "regional_media"
      ]
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "countryCode", "regionCode"],
      "properties": {
        "scope": {
          "enum": ["international", "eu", "national", "neighbor_country", "state"]
        },
        "countryCode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "regionCode": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 20
        }
      }
    },
    "originalLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
      }
    },
    "transport": {
      "enum": ["rss", "atom", "json_feed", "public_api", "licensed_api"]
    },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "fetchIntervalMinutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 1440
    },
    "licensePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadataAllowed", "summaryAllowed", "fullTextAllowed", "note"],
      "properties": {
        "metadataAllowed": { "type": "boolean" },
        "summaryAllowed": { "type": "boolean" },
        "fullTextAllowed": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "storagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawRetentionDays", "normalizedMetadataRetentionDays"],
      "properties": {
        "rawRetentionDays": { "type": "integer", "minimum": 0, "maximum": 30 },
        "normalizedMetadataRetentionDays": { "type": "integer", "minimum": 30, "maximum": 1825 }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshHours", "staleHours"],
      "properties": {
        "freshHours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "staleHours": { "type": "integer", "minimum": 2, "maximum": 720 }
      }
    },
    "status": {
      "enum": ["active", "paused", "error", "pending_review"]
    },
    "lastSuccessfulFetchAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "credentialRequired": {
      "type": "boolean",
      "default": false
    },
    "providerKey": {
      "type": ["string", "null"],
      "maxLength": 100
    }
  }
}
