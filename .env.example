# Root-level infra env (Docker Compose)
# App env: siehe apps/web/.env.example (nach apps/web/.env.local kopieren)

# Tri-Mongo (dev)
CORE_MONGODB_URI=mongodb://localhost:27017
CORE_DB_NAME=edebatte_core

VOTES_MONGODB_URI=mongodb://localhost:27018
VOTES_DB_NAME=edebatte_votes

PII_MONGODB_URI=mongodb://localhost:27019
PII_DB_NAME=edebatte_pii

# Optional AI reader (wenn benötigt)
AI_CORE_READER_MONGODB_URI=
AI_CORE_READER_DB_NAME=

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j (optional, PROFILE=graph)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234
NEO4J_AUTH=neo4j/test1234

# Web
NEXT_PUBLIC_BASE_URL=http://localhost:3000
