{
  "name": "Voxy Production Pack v3",
  "version": "3.0.0",
  "description": "Canonical Voxy mascot assets prepared for light and dark UI use with consistent branding.",
  "usage_notes": {
    "background": "Current raster exports carry a visible checkerboard background. Prefer cropped, masked, aura-led placement on the shared page canvas instead of hard image cards or screenshot-like rectangles.",
    "light_mode": "Use tighter crops, calm cyan/blue aura and no visible image container. Avoid dark foreign cards under the image.",
    "dark_mode": "Use the same shared canvas approach with softer aura and close crop. Do not invert the asset and do not place it on a bright rectangular block.",
    "branding": "VOG pin stays on viewer-right lapel. eDebatte wordmark stays blue on the pocket area in every variant."
  },
  "route_usage": {
    "heroLight": "confident",
    "heroDark": "confident",
    "createLight": "presenting",
    "createDark": "thinking",
    "dossierLight": "hint",
    "dossierDark": "thinking",
    "rundenLight": "open",
    "rundenDark": "confident",
    "swipesLight": "wave",
    "swipesDark": "mini-avatar",
    "miniAvatarLight": "mini-avatar",
    "miniAvatarDark": "mini-avatar"
  },
  "assets": [
    {"id": "neutral", "png": "/brand/voxy/voxy-neutral.png", "webp": "/brand/voxy/voxy-neutral.webp", "role": "default guide"},
    {"id": "thinking", "png": "/brand/voxy/voxy-thinking.png", "webp": "/brand/voxy/voxy-thinking.webp", "role": "analysis / optional AI"},
    {"id": "check", "png": "/brand/voxy/voxy-check.png", "webp": "/brand/voxy/voxy-check.webp", "role": "success / ready"},
    {"id": "hint", "png": "/brand/voxy/voxy-hint.png", "webp": "/brand/voxy/voxy-hint.webp", "role": "important note / guidance"},
    {"id": "welcome", "png": "/brand/voxy/voxy-welcome.png", "webp": "/brand/voxy/voxy-welcome.webp", "role": "onboarding / first step"},
    {"id": "presenting", "png": "/brand/voxy/voxy-presenting.png", "webp": "/brand/voxy/voxy-presenting.webp", "role": "explanation / panel guide"},
    {"id": "open", "png": "/brand/voxy/voxy-open.png", "webp": "/brand/voxy/voxy-open.webp", "role": "community / openness"},
    {"id": "confident", "png": "/brand/voxy/voxy-confident.png", "webp": "/brand/voxy/voxy-confident.webp", "role": "confidence / authority"},
    {"id": "wave", "png": "/brand/voxy/voxy-wave.png", "webp": "/brand/voxy/voxy-wave.webp", "role": "hello / lightweight greeting"},
    {"id": "mini-avatar", "png": "/brand/voxy/voxy-mini-avatar.png", "webp": "/brand/voxy/voxy-mini-avatar.webp", "role": "compact avatar"}
  ]
}
